# Copie ce fichier en .env.local (ou renseigne ces variables sur Vercel → Settings → Environment Variables)

# --- Base de données (Vercel KV / Upstash Redis) ---
# Ajoutées automatiquement quand on connecte une base KV au projet Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Messages d'encouragement générés par l'IA (OPTIONNEL, bonus P1) ---
# Sans cette clé, l'appli utilise sa banque de messages intégrée. Rien ne casse.
ANTHROPIC_API_KEY=
